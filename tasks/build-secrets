#!/usr/bin/env python3
# Write OpenShift secret volumes JSON to stdout
# https://docs.openshift.com/container-platform/3.9/dev_guide/secrets.html
import argparse
import base64
import json
import os
from pathlib import Path


def secret(path: Path, name: str, *, rstrip: bool = False) -> dict[str, object]:
    def encode(f: Path) -> str:
        data = f.read_text()
        return base64.b64encode((data.rstrip("\n") if rstrip else data).encode()).decode()

    return {
        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": {"name": name},
        "data": {f.name: encode(f) for f in path.iterdir() if f.is_file()},
    }


def main() -> None:
    parser = argparse.ArgumentParser(description="Write OpenShift secret volumes JSON to stdout")
    parser.add_argument(
        "--ci-secrets",
        type=Path,
        metavar="DIR",
        help="path to ci-secrets checkout (default: $XDG_RUNTIME_DIR/ci-secrets)",
    )
    args = parser.parse_args()
    ci_secrets = args.ci_secrets or Path(os.environ["XDG_RUNTIME_DIR"]) / "ci-secrets"

    secrets = {
        "apiVersion": "v1",
        "kind": "List",
        "items": [
            secret(ci_secrets / "tasks", "cockpit-tasks-secrets"),
            secret(ci_secrets / "s3-keys", "cockpit-s3-secrets"),
            secret(ci_secrets / "s3-log-read", "cockpit-s3-log-read-secrets"),
            secret(ci_secrets / "s3-server", "cockpit-s3-server-secrets"),
            secret(ci_secrets / "webhook", "webhook-secrets"),
            secret(ci_secrets / "metrics", "metrics-secrets", rstrip=True),
        ],
    }
    print(json.dumps(secrets, indent=2))


if __name__ == "__main__":
    main()
